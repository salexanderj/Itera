<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A neutral stage for checking a model drawn by the engine: no voxel world, a plain ground with a metre grid, the
    engine's own sky and look, and the models named by Engine:Assets:Extra. Driven by a startup script of console
    commands (README.md); tools/models/build.py runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ModelView</AssemblyName>
    <RootNamespace>Itera.Tools.ModelView</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Itera.Engine\Itera.Engine.csproj" />
    <ProjectReference Include="..\..\src\Itera.Modding\Itera.Modding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
