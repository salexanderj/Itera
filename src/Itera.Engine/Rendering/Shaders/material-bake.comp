#version 460

// The bake of a material's recipe into a texture set (docs/rendering-redesign.md, the materials plan, step 4;
// MeshPass.Bake.cs, the console's materials bake): the recipe's pattern (mesh-surface.glsl's surfacePattern) worked out
// at every detail over a tile of 256 cm square, its lattices wrapped so the tile repeats seamlessly, on the plane of x
// and z (bake.side 0: ground, seen from above) or of x and y (1: trunks and walls, seen from the side), into three
// layers of 1024 texels: the colour at no tint, sRGB-encoded, with the hollows as occlusion in alpha; the normal the
// relief's slope gives, as a normal map (x and y, z out of the surface, 0.5 for 0) in the texture's axes; and the
// height, from the hollows (crests high, cracks low). tools/Textures makes a set of them as of a photograph's maps.
#define MESH_SURFACE_TILE 256
#define MESH_SURFACE_BAKE
#extension GL_EXT_scalar_block_layout : require
#include "mesh-data.glsl"
#include "mesh-surface.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2DArray target;

layout(push_constant, scalar) uniform Bake
{
    uint material;
    uint side;
} bake;

const int BakeTexels = 1024;

vec3 toSrgb(vec3 linear)
{
    vec3 c = clamp(linear, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(BakeTexels))))
    {
        return;
    }

    // The texel's centre in centimetres along the texture's two axes, and the point and normal on the plane.
    vec2 centimetres = (vec2(texel) + 0.5) * (float(MESH_SURFACE_TILE) / float(BakeTexels));
    ivec2 whole2 = ivec2(floor(centimetres));
    vec2 part2 = centimetres - vec2(whole2);
    bool side = bake.side != 0u;
    ivec3 whole = side ? ivec3(whole2.x, whole2.y, 0) : ivec3(whole2.x, 0, whole2.y);
    vec3 part = side ? vec3(part2.x, part2.y, 0.0) : vec3(part2.x, 0.0, part2.y);
    vec3 normal = side ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);

    vec3 colour;
    vec3 gradient;
    float cavity;
    surfacePattern(bake.material, 0.0, whole, part, normal, 0.0, colour, gradient, cavity);
    // The slope in the surface's plane; the lit normal is normalize(normal - slope), so the texture's axes take minus
    // the slope (mesh-surface.glsl reads them back as surfaceTextured's bend: u along x, v along z or y).
    vec3 slope = gradient - dot(gradient, normal) * normal;
    vec2 tangent = side ? vec2(-slope.x, slope.y) : vec2(-slope.x, slope.z);
    vec3 tangentNormal = normalize(vec3(tangent, 1.0));

    imageStore(target, ivec3(texel, 0), vec4(toSrgb(colour), cavity));
    imageStore(target, ivec3(texel, 1), vec4(tangentNormal * 0.5 + 0.5, 1.0));
    imageStore(target, ivec3(texel, 2), vec4(cavity, 0.0, 0.0, 1.0));
}
