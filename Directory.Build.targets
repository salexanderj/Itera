<Project>
  <!--
    The sound code's hash: a SHA-256 of the source files under $(SoundCodeFolder) (set by Itera.Engine, and by a game
    that has sound recipes of its own, to their Audio folder), sorted by path, written as the assembly's "SoundCode"
    metadata. The sound cache keys its files by it (SoundCache.SoundCodeOf), so a commit that changes no sound code keeps
    the rendered sounds; the module version id would change with the commit's hash in the informational version.
  -->
  <UsingTask
    TaskName="SoundCodeHash"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Folder ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        // The task compiles against netstandard2.0: no SHA256.HashData or Convert.ToHexString.
        var prefix = Folder.Replace('\\', '/').TrimEnd('/') + "/";
        var lines = new List<string>();
        using (var sha = SHA256.Create())
        {
            foreach (var item in Files)
            {
                var path = item.ItemSpec.Replace('\\', '/');
                if (path.StartsWith(prefix, StringComparison.Ordinal))
                {
                    var bytes = File.ReadAllBytes(item.GetMetadata("FullPath"));
                    lines.Add(path + "=" + BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", ""));
                }
            }

            lines.Sort(StringComparer.Ordinal);
            var all = sha.ComputeHash(Encoding.UTF8.GetBytes(string.Join("\n", lines)));
            Hash = BitConverter.ToString(all).Replace("-", "").Substring(0, 32);
        }
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target
    Name="AddSoundCodeHash"
    BeforeTargets="CreateGeneratedAssemblyInfoInputsCacheFile"
    DependsOnTargets="GetAssemblyAttributes"
    Condition="'$(SoundCodeFolder)' != ''"
  >
    <SoundCodeHash Files="@(Compile)" Folder="$(SoundCodeFolder)">
      <Output TaskParameter="Hash" PropertyName="SoundCodeHash" />
    </SoundCodeHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SoundCode</_Parameter1>
        <_Parameter2>$(SoundCodeHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    Writes a copy of an IL-only x64 PE image whose COFF machine field says arm64, so an arm64 process loads it: an image
    marked x64 is skipped there as if missing. IL has no machine, so only the field changes. Rewritten only when the
    source is newer.
  -->
  <UsingTask
    TaskName="CopyMarkedForArm64"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        if (!File.Exists(Destination) || File.GetLastWriteTimeUtc(Destination) < File.GetLastWriteTimeUtc(Source))
        {
            // The machine field is the first of the COFF header, after the "PE\0\0" that offset 0x3C points to.
            var bytes = File.ReadAllBytes(Source);
            var header = BitConverter.ToInt32(bytes, 0x3C);
            if (bytes[header] != 'P' || bytes[header + 1] != 'E' || BitConverter.ToUInt16(bytes, header + 4) != 0x8664)
            {
                Log.LogError("CopyMarkedForArm64: " + Source + " is not an x64 PE image.");
                return false;
            }

            bytes[header + 4] = 0x64;
            bytes[header + 5] = 0xAA;
            Directory.CreateDirectory(Path.GetDirectoryName(Destination));
            File.WriteAllBytes(Destination, bytes);
        }
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    Steamworks.NET 2024.8.0 has managed builds for x64 and x86 only, each marked for its machine, and its file for any
    other platform (lib/netstandard2.1) is a reference assembly, which .NET does not run: an arm64 Mac found no
    Steamworks.NET. Every build copies the package's Unix x64 build in its place, marked for arm64. Its code depends on
    the system, not the architecture: with Steam's universal macOS library, Steam starts on an arm64 Mac. Linux and
    Windows on arm64 have no Steam library and play without Steam, as before (src/Itera.Engine/Native/Steam/README.md).
    Platforms with a build of their own take theirs.
  -->
  <Target Name="GiveArm64SteamworksUnixBuild" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_SteamworksStub
        Include="@(RuntimeCopyLocalItems)"
        Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Steamworks.NET' and '%(RuntimeCopyLocalItems.PathInPackage)' == 'lib/netstandard2.1/Steamworks.NET.dll'"
      />
    </ItemGroup>
    <PropertyGroup Condition="'@(_SteamworksStub)' != ''">
      <_SteamworksUnix>@(_SteamworksStub->'$(NuGetPackageRoot)steamworks.net/%(NuGetPackageVersion)/runtimes/osx-x64/lib/netstandard2.1/%(Filename)%(Extension)')</_SteamworksUnix>
      <_SteamworksArm64>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'steamworks-arm64', 'Steamworks.NET.dll'))</_SteamworksArm64>
    </PropertyGroup>
    <CopyMarkedForArm64
      Condition="'@(_SteamworksStub)' != ''"
      Source="$(_SteamworksUnix)"
      Destination="$(_SteamworksArm64)"
    />
    <ItemGroup Condition="'@(_SteamworksStub)' != ''">
      <RuntimeCopyLocalItems Remove="@(_SteamworksStub)" />
      <RuntimeCopyLocalItems Include="@(_SteamworksStub->'$(_SteamworksArm64)')" />
    </ItemGroup>
  </Target>
</Project>
